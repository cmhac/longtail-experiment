{
  "name": "db",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/db/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:library"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/backend ruff check libs/db"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/backend ruff format --check libs/db"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PYTHONPATH=libs/db/src uv run --project apps/backend ty check libs/db"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "workspaceConfig",
        "pythonAppConfig",
        "repoContractFiles"
      ],
      "options": {
        "command": "uv run --project apps/backend pytest libs/db/tests"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "workspaceConfig",
        "pythonAppConfig",
        "repoContractFiles"
      ],
      "options": {
        "command": "uv run --project apps/backend pytest libs/db/tests --cov=libs/db/src --cov-fail-under=90"
      }
    }
  }
}
