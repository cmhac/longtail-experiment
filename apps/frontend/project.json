{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend/src",
  "projectType": "application",
  "tags": ["scope:frontend", "type:app"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/frontend dev"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/frontend build"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/frontend start"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/frontend lint"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/frontend format"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/frontend typecheck"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/frontend test"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/frontend coverage"
      }
    },
    "test:discovery-pages": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --dir apps/frontend test -- tests/home-page.test.tsx tests/catalog-page.test.tsx tests/detail-page.test.tsx"
      }
    }
  }
}
