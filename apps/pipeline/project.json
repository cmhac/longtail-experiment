{
  "name": "pipeline",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/pipeline/src",
  "projectType": "application",
  "tags": ["scope:pipeline", "type:placeholder"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/pipeline ruff check apps/pipeline"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/pipeline ruff format --check apps/pipeline"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/pipeline ty check apps/pipeline"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "workspaceConfig",
        "pythonAppConfig"
      ],
      "options": {
        "command": "uv run --project apps/pipeline pytest apps/pipeline/tests"
      }
    },
    "test:orchestration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/pipeline pytest apps/pipeline/tests/orchestration"
      }
    },
    "test:orchestration:cadence": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/pipeline pytest --no-cov apps/pipeline/tests/orchestration -k \"cadence or due or schedule_policy\""
      }
    },
    "test:orchestration:parallel": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/pipeline pytest --no-cov apps/pipeline/tests/orchestration -k \"parallel or concurrency or queue\""
      }
    },
    "test:orchestration:source-assets": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/pipeline pytest --no-cov apps/pipeline/tests/orchestration -k \"source_asset or single_source_trigger or outcome_visibility or cutover_partial_failure or scheduler_runtime\""
      }
    },
    "test:orchestration:dynamic-registration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/pipeline pytest --no-cov apps/pipeline/tests/orchestration/test_source_asset_discovery.py apps/pipeline/tests/orchestration/test_source_asset_contract_validation.py apps/pipeline/tests/orchestration/test_definitions_smoke.py"
      }
    },
    "test:provider-bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/pipeline pytest --no-cov apps/pipeline/tests/unit/test_provider_bootstrap_validation.py apps/pipeline/tests/unit/test_provider_bootstrap_collision_checks.py apps/pipeline/tests/unit/test_provider_bootstrap_render.py apps/pipeline/tests/integration/test_provider_bootstrap_cli_success.py apps/pipeline/tests/integration/test_provider_bootstrap_cli_invalid_input.py apps/pipeline/tests/integration/test_provider_bootstrap_cli_collisions.py apps/pipeline/tests/contract/test_provider_bootstrap_scaffold_contract.py apps/pipeline/tests/contract/test_provider_onboarding_runbook_standard.py apps/pipeline/tests/contract/test_onboard_provider_skill_bootstrap_standard.py"
      }
    },
    "test:orchestration:multi-series": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/pipeline pytest --no-cov apps/pipeline/tests/orchestration -k \"series or grouped or split or ownership_transition\""
      }
    },
    "test:orchestration:metadata-store": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/pipeline pytest --no-cov apps/pipeline/tests/orchestration/test_dagster_metadata_storage_config.py apps/pipeline/tests/orchestration/test_dagit_runtime_fail_fast.py apps/pipeline/tests/orchestration/test_dagster_metadata_concurrency.py"
      }
    },
    "verify:multi-series": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "uv run --project apps/pipeline pytest --no-cov apps/pipeline/tests/orchestration/test_fred_source_workflow.py apps/pipeline/tests/orchestration/test_trigger_modes.py apps/pipeline/tests/orchestration/test_definitions_smoke.py apps/pipeline/tests/orchestration/test_ingest_job_runtime.py",
          "pnpm run affected:test"
        ],
        "parallel": false
      }
    },
    "verify:dynamic-registration": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "uv run --project apps/pipeline pytest --no-cov apps/pipeline/tests/orchestration/test_source_asset_discovery.py apps/pipeline/tests/orchestration/test_source_asset_contract_validation.py apps/pipeline/tests/orchestration/test_definitions_smoke.py",
          "docker compose up -d dagit",
          "docker compose ps dagit"
        ],
        "parallel": false
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "workspaceConfig",
        "pythonAppConfig"
      ],
      "options": {
        "command": "uv run --project apps/pipeline pytest apps/pipeline/tests --cov=apps/pipeline/src --cov-fail-under=90"
      }
    }
  }
}
