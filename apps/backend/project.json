{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "tags": ["scope:backend", "type:placeholder"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/backend ruff check apps/backend"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/backend ruff format --check apps/backend"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/backend ty check apps/backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "workspaceConfig",
        "pythonAppConfig"
      ],
      "options": {
        "command": "uv run --project apps/backend pytest apps/backend/tests"
      }
    },
    "test:discovery-contract": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/backend pytest apps/backend/tests/contract/test_dataset_* apps/backend/tests/contract/test_dataset_discovery_*"
      }
    },
    "test:discovery-runtime": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --project apps/backend pytest --no-cov apps/backend/tests/contract/test_runtime_* apps/backend/tests/contract/test_http_runtime_* apps/backend/tests/contract/test_ingest_to_discovery_runtime_*"
      }
    },
    "coverage": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^default",
        "workspaceConfig",
        "pythonAppConfig"
      ],
      "options": {
        "command": "uv run --project apps/backend pytest apps/backend/tests --cov=apps/backend/src --cov-fail-under=90"
      }
    }
  }
}
