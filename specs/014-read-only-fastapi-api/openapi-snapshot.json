                            "title": "Page"
                        },
                        "description": "Page number (1-based)"
                    },
                    {
                        "name": "page_size",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "maximum": 200,
                            "minimum": 1,
                            "description": "Items per page (1-200)",
